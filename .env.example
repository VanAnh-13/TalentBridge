# Copy to .env for `docker compose up --build`. Never commit .env.

# Required: RSA private key that signs access tokens (RS256), as base64 of the PEM file:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
# Services verify tokens with the public half, published at /.well-known/jwks.json.
JWT_PRIVATE_KEY=

# First administrator, created on first start only when no admin exists. Leave empty to skip.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Database / cache (defaults are fine for local use)
DB_NAME=talentbridge
DB_USER=talentbridge_user
DB_PASSWORD=change_this_password
DB_ROOT_PASSWORD=change_this_root_password
REDIS_PASSWORD=change_this_redis_password

# Ports and addresses
API_PORT=8080
WEB_PORT=3000
# Address of the web app: allowed CORS origin, and the base of links in e-mails
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080

# Time zone of the containers and of interview times written in notifications
TIME_ZONE=Asia/Ho_Chi_Minh

# File storage: local (default) or gcs; gcs also needs GCS_PROJECT_ID and GCS_BUCKET_NAME on the backend
STORAGE_TYPE=local

# Optional mail (password reset, job digest). Leave MAIL_HOST empty to disable.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@talentbridge.com

# Optional AI CV-job matching (Claude API). Leave the key empty to keep the feature off. Each scored CV is one paid API call.
ANTHROPIC_API_KEY=
MATCHING_MODEL=claude-opus-5-5
